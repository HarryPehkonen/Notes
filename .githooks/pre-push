#!/usr/bin/env bash
#
# git runs this before a push leaves this machine - but only if the clone has
# been told where to look, once:
#
#     git config core.hooksPath .githooks
#
# Nothing leaves the machine to make this work: no GitHub, no service, no
# account. It is the same gate a human runs by hand and the nightly clean
# checkout runs, so a passing push means the same thing everywhere.
#
# Deliberate bypass when you need one:  git push --no-verify
#
# 2026-10-06 (card t_075c0a6f): the gate IS gate.toml now, run by kit-ci, so this hook NAMES
# A TIER instead of leaving the tier implicit — the stage list lives in one place, gate.toml,
# and a hook that names the tier cannot drift from it. This repo pushes with the whole gate
# (its checks are seconds); .githooks/ carries no pre-commit, so nothing names the fast tier
# yet.
exec "$(git rev-parse --show-toplevel)/scripts/gate.sh" --tier full
